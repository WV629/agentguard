# Copy to .env and fill in. Never commit .env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# The agent's account and its FUNCTION-CALL key (never a full-access key)
AGENT_ACCOUNT_ID=agentguard-demo.testnet
AGENT_PRIVATE_KEY=ed25519:...
# Policy file
AGENTGUARD_POLICY=config/policy.example.toml
