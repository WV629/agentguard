# Copy to .env and fill in. Never commit .env or any key file.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# The agent's sandboxed wallet account
AGENT_ACCOUNT_ID=agentguard-demo.testnet
# Key the GATEWAY signs with (held by the gateway process only, never by the agent).
# Either the key itself or a near-cli style JSON key file kept OUTSIDE the repo.
GATEWAY_PRIVATE_KEY=
GATEWAY_KEY_FILE=~/.near-credentials/testnet/agentguard-demo.testnet.json
# Optional: the agent's own FUNCTION-CALL key (never full access)
AGENT_PRIVATE_KEY=
AGENT_KEY_FILE=
# Policy file and logs
AGENTGUARD_POLICY=config/policy.example.toml
AGENTGUARD_AUDIT_LOG=data/audit.jsonl
AGENTGUARD_APPROVALS=data/approvals.jsonl
